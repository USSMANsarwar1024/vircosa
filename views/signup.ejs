<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vircosa | Create Account</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #8b5a2b;
      --secondary-color: #2a2118;
      --accent-color: #d4af37;
      --success-color: #28a745;
      --error-color: #dc3545;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Montserrat', sans-serif;
      background: linear-gradient(135deg, rgba(42, 33, 24, 0.95), rgba(139, 90, 43, 0.85)),
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%232a2118"/><stop offset="100%" style="stop-color:%238b5a2b"/></linearGradient></defs><rect fill="url(%23g)" width="1200" height="800"/><circle cx="200" cy="150" r="180" fill="rgba(212,175,55,0.1)"/><circle cx="900" cy="550" r="220" fill="rgba(212,175,55,0.08)"/></svg>');
      background-size: cover;
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 40px 20px;
      overflow-x: hidden;
    }

    .particle {
      position: fixed;
      width: 4px;
      height: 4px;
      background: rgba(212, 175, 55, 0.6);
      border-radius: 50%;
      pointer-events: none;
      animation: float 15s infinite ease-in-out;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); opacity: 0; }
      10%, 90% { opacity: 1; }
      100% { transform: translateY(-100vh); }
    }

    .container { max-width: 1000px; animation: fadeInUp 0.8s; }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .register-card {
      margin-top: 90px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      background: rgba(248, 245, 242, 0.98);
      backdrop-filter: blur(20px);
      position: relative;
      animation: slideIn 0.6s;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    .register-card::before, .register-card::after {
      content: '';
      position: absolute;
      width: 100px;
      height: 100px;
      border: 2px solid var(--accent-color);
      opacity: 0.3;
      z-index: 0;
    }

    .register-card::before {
      top: -2px;
      left: -2px;
      border-right: none;
      border-bottom: none;
      border-radius: 20px 0 0 0;
    }

    .register-card::after {
      bottom: -2px;
      right: -2px;
      border-left: none;
      border-top: none;
      border-radius: 0 0 20px 0;
    }

    .card-header {
      background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
      color: white;
      padding: 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .card-header::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
      animation: rotate 20s linear infinite;
    }

    @keyframes rotate { to { transform: rotate(360deg); } }

    .card-header-content { position: relative; z-index: 1; }

    .logo-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--accent-color);
      animation: pulse 2s infinite;
      display: inline-block;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .card-header h2 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: 2.2rem;
      letter-spacing: 2px;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .card-header p {
      font-size: 0.85rem;
      letter-spacing: 3px;
      margin-top: 0.5rem;
      opacity: 0.9;
    }

    .card-body { padding: 2.5rem; position: relative; z-index: 1; }

    .form-group {
      margin-bottom: 1.5rem;
      position: relative;
    }

    .form-group label {
      font-weight: 600;
      margin-bottom: 0.7rem;
      display: block;
      color: var(--secondary-color);
      font-size: 0.9rem;
    }

    .input-wrapper { position: relative; }

    .form-control, textarea.form-control {
      height: 52px;
      border-radius: 12px;
      border: 2px solid #e0e0e0;
      padding-left: 50px;
      padding-right: 15px;
      transition: all 0.3s;
      background: white;
      font-size: 0.95rem;
    }

    textarea.form-control {
      height: auto;
      padding: 15px 15px 15px 50px;
      min-height: 80px;
    }

    .form-control:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 0.25rem rgba(139, 90, 43, 0.15);
      transform: translateY(-2px);
    }

    .input-icon {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--secondary-color);
      font-size: 1.1rem;
      opacity: 0.6;
      transition: all 0.3s;
      pointer-events: none;
    }

    textarea + .input-icon { top: 25px; transform: none; }

    .toggle-password {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--secondary-color);
      opacity: 0.6;
      cursor: pointer;
      transition: all 0.3s;
      padding: 5px;
    }

    .toggle-password:hover {
      opacity: 1;
      color: var(--primary-color);
    }

    .password-strength {
      height: 6px;
      background: #eee;
      border-radius: 3px;
      margin-top: 8px;
      overflow: hidden;
    }

    .strength-bar {
      height: 100%;
      width: 0;
      transition: all 0.3s;
      border-radius: 3px;
    }

    .strength-text {
      font-size: 0.8rem;
      margin-top: 5px;
      font-weight: 500;
    }

    .gender-options {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .gender-card {
      flex: 1;
      min-width: 120px;
      border: 2px solid #e0e0e0;
      border-radius: 12px;
      padding: 1.2rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s;
      background: white;
    }

    .gender-card:hover {
      border-color: var(--primary-color);
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .gender-card input { display: none; }

    .gender-card.selected {
      border-color: var(--primary-color);
      background: rgba(139, 90, 43, 0.05);
    }

    .gender-card i {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      display: block;
      color: var(--secondary-color);
      transition: all 0.3s;
    }

    .gender-card.selected i {
      color: var(--primary-color);
      transform: scale(1.1);
    }

    .gender-card span {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .form-control.is-invalid {
      border-color: var(--error-color);
      animation: shake 0.4s;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .form-control.is-valid { border-color: var(--success-color); }

    .invalid-feedback, .valid-feedback {
      display: none;
      font-size: 0.85rem;
      margin-top: 0.4rem;
    }

    .invalid-feedback { color: var(--error-color); }
    .valid-feedback { color: var(--success-color); }

    .form-control.is-invalid ~ .invalid-feedback { display: block; }
    .form-control.is-valid ~ .valid-feedback { display: block; }

    .profile-upload {
      border: 2px dashed #e0e0e0;
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s;
      background: white;
    }

    .profile-upload:hover {
      border-color: var(--primary-color);
      background: rgba(139, 90, 43, 0.02);
    }

    .upload-icon {
      font-size: 3rem;
      color: var(--primary-color);
      margin-bottom: 1rem;
      opacity: 0.6;
    }

    .preview-image {
      max-width: 150px;
      max-height: 150px;
      border-radius: 50%;
      margin: 1rem auto;
      display: none;
      border: 4px solid var(--accent-color);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .terms-box {
      background: rgba(139, 90, 43, 0.05);
      border: 2px solid #e0e0e0;
      border-radius: 12px;
      padding: 1.5rem;
      margin: 1.5rem 0;
      transition: all 0.3s;
    }

    .terms-box:hover { border-color: var(--primary-color); }

    .form-check-input {
      width: 20px;
      height: 20px;
      border: 2px solid #e0e0e0;
      cursor: pointer;
    }

    .form-check-input:checked {
      background-color: var(--primary-color);
      border-color: var(--primary-color);
    }

    .form-check-label {
      margin-left: 0.5rem;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .form-check-label a {
      color: var(--primary-color);
      font-weight: 600;
      text-decoration: none;
    }

    .form-check-label a:hover { text-decoration: underline; }

    .btn-register {
      background: linear-gradient(135deg, var(--primary-color), #6d4622);
      border: none;
      height: 55px;
      font-weight: 600;
      letter-spacing: 1.5px;
      border-radius: 12px;
      transition: all 0.3s;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .btn-register::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .btn-register:hover::before {
      width: 300px;
      height: 300px;
    }

    .btn-register:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(139, 90, 43, 0.4);
    }

    .btn-register span { position: relative; z-index: 1; }

    .btn-register.loading span { opacity: 0; }

    .btn-register.loading::after {
      content: '';
      position: absolute;
      width: 20px;
      height: 20px;
      top: 50%;
      left: 50%;
      margin: -10px 0 0 -10px;
      border: 3px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .login-link {
      text-align: center;
      margin-top: 1.5rem;
      padding: 1.5rem;
      background: rgba(139, 90, 43, 0.05);
      border-radius: 12px;
    }

    .login-link a {
      color: var(--primary-color);
      font-weight: 600;
      text-decoration: none;
    }

    .login-link a:hover { text-decoration: underline; }

    .card-footer {
      background: rgba(0, 0, 0, 0.02);
      border-top: 1px solid rgba(0, 0, 0, 0.05);
      text-align: center;
      padding: 1.5rem;
    }

    .back-home a {
      color: var(--primary-color);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .back-home a:hover { transform: translateX(-5px); }

    @media (max-width: 768px) {
      .card-header, .card-body { padding: 2rem 1.5rem; }
      .gender-options { flex-direction: column; }
    }
  </style>
</head>

<body>
      <%- include('partials/navbar') %>

  <div class="particle" style="left: 10%; animation-delay: 0s;"></div>
  <div class="particle" style="left: 25%; animation-delay: 2s;"></div>
  <div class="particle" style="left: 40%; animation-delay: 1s;"></div>
  <div class="particle" style="left: 55%; animation-delay: 3s;"></div>
  <div class="particle" style="left: 70%; animation-delay: 1.5s;"></div>
  <div class="particle" style="left: 85%; animation-delay: 2.5s;"></div>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="register-card card">
          <div class="card-header">
            <div class="card-header-content">
              <i class="fas fa-user-plus logo-icon"></i>
              <h2>Join Vircosa</h2>
              <p>CREATE YOUR ACCOUNT</p>
            </div>
          </div>

          <div class="card-body">
            <form method="POST" action="/signup" enctype="multipart/form-data">
              <div class="row">
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="firstName">First Name *</label>
                    <div class="input-wrapper">
                      <input type="text" class="form-control" id="firstName" name="firstname" 
                        placeholder="Firstname" required minlength="2" maxlength="50">
                      <i class="fas fa-user input-icon"></i>
                    </div>
                    <div class="invalid-feedback">Enter 2-50 characters</div>
                    <div class="valid-feedback">Perfect!</div>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="form-group">
                    <label for="lastName">Last Name *</label>
                    <div class="input-wrapper">
                      <input type="text" class="form-control" id="lastName" name="lastname" 
                        placeholder="Lastname" required minlength="2" maxlength="50">
                      <i class="fas fa-user input-icon"></i>
                    </div>
                    <div class="invalid-feedback">Enter 2-50 characters</div>
                    <div class="valid-feedback">Perfect!</div>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label>Gender *</label>
                <div class="gender-options">
                  <label class="gender-card selected">
                    <input type="radio" name="gender" value="m" checked>
                    <i class="fas fa-mars"></i>
                    <span>Male</span>
                  </label>
                  <label class="gender-card">
                    <input type="radio" name="gender" value="f">
                    <i class="fas fa-venus"></i>
                    <span>Female</span>
                  </label>
                  <label class="gender-card">
                    <input type="radio" name="gender" value="o">
                    <i class="fas fa-genderless"></i>
                    <span>Other</span>
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label for="email">Email Address *</label>
                <div class="input-wrapper">
                  <input type="email" class="form-control" id="email" name="email" 
                    placeholder="user@example.com" required>
                  <i class="fas fa-envelope input-icon"></i>
                </div>
                <div class="invalid-feedback">Enter a valid email</div>
                <div class="valid-feedback">Email looks great!</div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="password">Password *</label>
                    <div class="input-wrapper">
                      <input type="password" class="form-control" id="password" name="password" 
                        placeholder="Create password" required minlength="8">
                      <i class="fas fa-lock input-icon"></i>
                      <button type="button" class="toggle-password" onclick="togglePass('password')">
                        <i class="fas fa-eye" id="passIcon"></i>
                      </button>
                    </div>
                    <small class="text-muted">Min 8 chars, uppercase, number & symbol</small>
                    <div class="password-strength">
                      <div class="strength-bar" id="strengthBar"></div>
                    </div>
                    <div class="strength-text" id="strengthText"></div>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="form-group">
                    <label for="confirmPassword">Confirm Password *</label>
                    <div class="input-wrapper">
                      <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                        placeholder="Confirm password" required>
                      <i class="fas fa-lock input-icon"></i>
                      <button type="button" class="toggle-password" onclick="togglePass('confirmPassword')">
                        <i class="fas fa-eye" id="confIcon"></i>
                      </button>
                    </div>
                    <div class="invalid-feedback">Passwords don't match</div>
                    <div class="valid-feedback">Passwords match!</div>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label for="phoneNumber">Phone Number *</label>
                <div class="input-wrapper">
                  <input type="tel" class="form-control" id="phoneNumber" name="phone" 
                    placeholder="03001234567" pattern="^(\+92|92|0)?3\d{9}$" required>
                  <i class="fas fa-phone input-icon"></i>
                </div>
                <small class="text-muted">Pakistani number (e.g., 03001234567)</small>
                <div class="invalid-feedback">Enter valid PK number</div>
                <div class="valid-feedback">Valid number!</div>
              </div>

              <div class="form-group">
                <label for="address">Shipping Address</label>
                <div class="input-wrapper">
                  <textarea class="form-control" id="address" name="address" 
                    placeholder="Your address" rows="2" maxlength="200"></textarea>
                  <i class="fas fa-map-marker-alt input-icon"></i>
                </div>
                <small class="text-muted">Optional - for delivery</small>
              </div>

              <div class="form-group">
                <label>Profile Picture (Optional)</label>
                <div class="profile-upload" onclick="document.getElementById('profilePicture').click()">
                  <i class="fas fa-cloud-upload-alt upload-icon"></i>
                  <p><strong>Click to upload</strong> or drag and drop</p>
                  <small class="text-muted">JPG, PNG or GIF (Max 5MB)</small>
                </div>
                <input type="file" id="profilePicture" name="profilePicture" accept="image/*" style="display:none">
                <img id="preview" class="preview-image" src="#" alt="Preview" />
              </div>

              <div class="terms-box">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="terms" required>
                  <label class="form-check-label" for="terms">
                    I agree to <a href="/terms" target="_blank">Terms of Service</a> and 
                    <a href="/privacy" target="_blank">Privacy Policy</a>
                  </label>
                </div>
              </div>

              <button type="submit" class="btn btn-register w-100">
                <span><i class="fas fa-user-plus me-2"></i>CREATE ACCOUNT</span>
              </button>

              <div class="login-link">
                Already have an account? <a href="/login">Sign in here</a>
              </div>
            </form>
          </div>

          <div class="card-footer">
            <div class="back-home">
              <a href="/">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Home</span>
              </a>
            </div>
            <div class="mt-3">
              <small>&copy; 2025 Vircosa. All Rights Reserved.</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Gender card selection
    document.querySelectorAll('.gender-card').forEach(card => {
      card.addEventListener('click', function() {
        document.querySelectorAll('.gender-card').forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');
        this.querySelector('input').checked = true;
      });
    });

    // Toggle password visibility
    function togglePass(id) {
      const input = document.getElementById(id);
      const icon = document.getElementById(id === 'password' ? 'passIcon' : 'confIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    // Password strength
    const password = document.getElementById('password');
    const bar = document.getElementById('strengthBar');
    const text = document.getElementById('strengthText');

    password.addEventListener('input', function() {
      const val = this.value;
      let strength = 0;
      
      if (val.length >= 8) strength++;
      if (/[A-Z]/.test(val)) strength++;
      if (/[0-9]/.test(val)) strength++;
      if (/[^A-Za-z0-9]/.test(val)) strength++;
      
      const colors = ['#e74c3c', '#f39c12', '#3498db', '#27ae60'];
      const labels = ['Weak', 'Fair', 'Good', 'Strong'];
      
      bar.style.width = (strength * 25) + '%';
      bar.style.backgroundColor = colors[strength - 1] || 'transparent';
      text.textContent = strength > 0 ? labels[strength - 1] : '';
      text.style.color = colors[strength - 1] || '';
      
      validateMatch();
    });

    // Password match
    const confirmPassword = document.getElementById('confirmPassword');
    
    function validateMatch() {
      if (password.value !== confirmPassword.value && confirmPassword.value) {
        confirmPassword.classList.add('is-invalid');
        confirmPassword.classList.remove('is-valid');
      } else if (confirmPassword.value) {
        confirmPassword.classList.remove('is-invalid');
        confirmPassword.classList.add('is-valid');
      }
    }

    confirmPassword.addEventListener('input', validateMatch);

    // Profile picture preview
    document.getElementById('profilePicture').addEventListener('change', function(e) {
      const file = e.target.files[0];
      const preview = document.getElementById('preview');
      
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          preview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    // Real-time validation
    const fields = [
      { id: 'firstName', min: 2, max: 50 },
      { id: 'lastName', min: 2, max: 50 },
      { id: 'email', regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/ },
      { id: 'phoneNumber', regex: /^(\+92|92|0)?3\d{9}$/ }
    ];

    fields.forEach(field => {
      const input = document.getElementById(field.id);
      input.addEventListener('input', function() {
        let valid = false;
        
        if (field.regex) {
          valid = field.regex.test(this.value);
        } else if (field.min && field.max) {
          valid = this.value.length >= field.min && this.value.length <= field.max;
        }
        
        if (this.value && valid) {
          this.classList.remove('is-invalid');
          this.classList.add('is-valid');
        } else if (this.value) {
          this.classList.remove('is-valid');
          this.classList.add('is-invalid');
        } else {
          this.classList.remove('is-valid', 'is-invalid');
        }
      });
    });

    // Form submission
    document.getElementById('signupForm').addEventListener('submit', function(e) {
      const btn = document.querySelector('.btn-register');
      btn.classList.add('loading');
    });

    // Input focus effects
    document.querySelectorAll('.form-control').forEach(input => {
      input.addEventListener('focus', function() {
        const label = this.closest('.form-group').querySelector('label');
        if (label) label.style.color = 'var(--primary-color)';
      });
      
      input.addEventListener('blur', function() {
        const label = this.closest('.form-group').querySelector('label');
        if (label) label.style.color = 'var(--secondary-color)';
      });
    });
  </script>
</body>
</html>