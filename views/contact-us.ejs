<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Vircosa</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts (Playfair Display + Montserrat) -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../stylesheets/navbar-styles.css">
    <link rel="stylesheet" href="../stylesheets/footer-styles.css">
    <link rel="stylesheet" href="../stylesheets/main-styles.css">
    <link rel="stylesheet" href="../stylesheets/cta-section-styles.css">
    <link rel="stylesheet" href="../stylesheets/newsletter-styles.css">
    
    <style>
        /* ===== Contact Hero ===== */
        .contact-hero {
            background: linear-gradient(rgba(33, 26, 19, 0.5), rgba(0, 0, 0, 0.9)),
                url('../images/connect-hero.svg') no-repeat center;
            background-size: 38rem;
            color: #ffffff;
            padding: 150px 0 100px;
            text-align: center;
            position: relative;
            margin-bottom: 80px;
            overflow: hidden;
        }

        .contact-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6);
        }

        .contact-hero p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 30px;
            opacity: 0.9;
            font-weight: 300;
        }

        /* ===== Contact Section ===== */
        .contact-section {
            padding: 0 0 100px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h2 {
            font-weight: 700;
            color: var(--secondary-color);
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }

        .section-title h2:after {
            content: '';
            position: absolute;
            width: 80px;
            height: 2px;
            background-color: var(--primary-color);
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
        }

        .contact-form {
            background-color: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
        }

        .form-control {
            border: 1px solid #f1d9d9;
            border-radius: 7.5px;
            padding: 12px 15px;
            margin-bottom: 20px;
            background-color: var(--light-color);
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: none;
            background-color: white;
        }

        .btn-contact {
            background-color: var(--primary-color);
            color: white;
            padding: 12px 35px;
            border-radius: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            border: none;
            transition: all 0.3s ease;
            width: 100%;
        }

        .btn-contact:hover {
            background-color: var(--secondary-color);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            color: white;
        }

        .btn-contact:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .contact-info {
            background-color: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
            height: 100%;
        }

        .contact-info h3 {
            color: var(--secondary-color);
            margin-bottom: 25px;
            position: relative;
            padding-bottom: 15px;
        }

        .contact-info h3:after {
            content: '';
            position: absolute;
            width: 50px;
            height: 2px;
            background-color: var(--primary-color);
            bottom: 0;
            left: 0;
        }

        .info-item {
            margin-bottom: 25px;
            display: flex;
            align-items: flex-start;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background-color: var(--accent-color);
            color: var(--secondary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .info-content h4 {
            font-family: 'Playfair Display', serif;
            color: var(--secondary-color);
            margin-bottom: 5px;
        }

        .info-content p {
            color: #666;
            margin-bottom: 0;
        }

        /* ===== Map Section ===== */
        .map-section {
            padding: 100px 0;
            background-color: var(--secondary-color);
            color: #fff;
            text-align: center;
        }

        .map-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: 15px;
            overflow: hidden;
            margin: 0 auto;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        }

        .map-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

        @keyframes fadeInMap {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .map-container {
            animation: fadeInMap 1.2s ease-in-out;
        }

        /* Success Modal Styles */
        #successModal .modal-content {
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(139, 90, 43, 0.15);
            background: linear-gradient(135deg, #ffffff 0%, #F8F5F2 100%);
        }

        .text-amber { color: var(--amber) !important; }
        .bg-amber { background-color: var(--amber) !important; }
        .bg-amber-light { background-color: var(--amber-lighter) !important; }

        .btn-amber { 
            background-color: var(--amber); 
            border-color: var(--amber);
            color: white;
            border-radius: 10px;
            padding: 10px 25px;
            font-weight: 500;
        }
        .btn-amber:hover {
            background-color: #7a4d24;
            border-color: #7a4d24;
            color: white;
        }
        .btn-outline-amber {
            color: var(--amber);
            border-color: var(--amber);
            border-radius: 10px;
            padding: 10px 25px;
            font-weight: 500;
        }
        .btn-outline-amber:hover {
            background-color: var(--amber);
            color: white;
        }

        .icon-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid var(--amber-light);
            position: relative;
            transition: transform 0.3s ease;
        }

        .icon-circle::after {
            content: '';
            position: absolute;
            top: -6px;
            left: -6px;
            right: -6px;
            bottom: -6px;
            border-radius: 50%;
            border: 2px dashed var(--amber-light);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .confirmation-details {
            background-color: rgba(212, 175, 142, 0.1) !important;
            border: 1px solid rgba(139, 90, 43, 0.1);
        }

        .detail-item {
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            flex-wrap: wrap;
        }

        .next-steps ul li {
            padding: 8px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .next-steps ul li:last-child {
            border-bottom: none;
        }

        .modal.fade .modal-dialog {
            transform: translateY(50px) scale(0.9);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .modal.show .modal-dialog {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        /* Error Alert */
        .alert-custom {
            border-radius: 10px;
            padding: 15px 20px;
            margin-bottom: 20px;
            border-left: 4px solid;
        }

        .alert-error {
            background-color: #fee;
            border-left-color: #c33;
            color: #c33;
        }

        /* Responsive Adjustments */
        @media (max-width: 992px) {
            .contact-hero h1 {
                font-size: 3rem;
            }
        }

        @media (max-width: 768px) {
            .contact-hero {
                padding: 120px 0 80px;
            }

            .contact-hero h1 {
                font-size: 2.5rem;
            }

            .contact-form,
            .contact-info {
                padding: 30px;
            }

            .map-section {
                padding: 70px 0;
            }

            .map-container {
                aspect-ratio: 4 / 3;
            }

            #successModal .modal-dialog {
                margin: 1rem;
            }
            
            .modal-body {
                padding: 1.5rem !important;
            }
            
            .confirmation-details .row > div {
                margin-bottom: 1rem;
            }
            
            .confirmation-details .row > div:last-child {
                margin-bottom: 0;
            }
            
            .modal-footer {
                flex-direction: column;
                gap: 10px;
            }
            
            .modal-footer .btn {
                width: 100%;
                margin: 5px 0 !important;
            }
        }

        @media (max-width: 576px) {
            .contact-hero h1 {
                font-size: 2rem;
            }

            .section-title h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <!-- Contact Hero -->
    <section class="contact-hero">
        <div class="container">
            <h1>Connect With Us</h1>
            <p>Your thoughts, questions, and feedback are the essence that helps us craft better experiences. Let's start a fragrant conversation.</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section">
        <div class="container">
            <div class="section-title">
                <h2>How Can We Help?</h2>
                <p class="text-muted">We typically respond within 2 hours</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="contact-form">
                        <!-- Error Alert -->
                        <div id="errorAlert" class="alert-custom alert-error" style="display: none;">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Oops!</strong> Something went wrong. Please try again or contact us directly.
                        </div>

                        <form id="contactForm" action="/contact-us" method="POST">
                            <div class="row">
                                <div class="col-md-6">
                                    <input name="firstName" type="text" class="form-control" placeholder="First Name" required>
                                </div>
                                <div class="col-md-6">
                                    <input name="lastName" type="text" class="form-control" placeholder="Last Name">
                                </div>
                            </div>

                            <input name="email" type="email" class="form-control" placeholder="Email Address" required>
                            <input name="phone" type="tel" class="form-control" placeholder="Phone Number">

                            <select name="topic" class="form-control" required>
                                <option value="" disabled selected>What can we help you with?</option>
                                <option>Product Inquiry</option>
                                <option>Order Support</option>
                                <option>Wholesale Questions</option>
                                <option>Press & Media</option>
                                <option>Suggestions</option>
                                <option>Other</option>
                            </select>

                            <textarea name="message" class="form-control" rows="5" placeholder="Your Message" required></textarea>

                            <button type="submit" class="btn btn-contact" id="submitBtn">Send Message</button>
                        </form>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="contact-info">
                        <h3>Contact Information</h3>
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="info-content">
                                <h4>Visit Our Atelier</h4>
                                <p>Phase 1<br>Johar Town, Lahore</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div class="info-content">
                                <h4>Call Us</h4>
                                <p>+92 308 1036 864<br>Mon-Fri, 9am-5pm PST</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <h4>Email Us</h4>
                                <p>info@vircosa.com<br>We usually reply within 12 hours</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="info-content">
                                <h4>Customer Care Hours</h4>
                                <p>Monday to Friday: 9:00 - 5:00<br>Saturday: 10:00 - 5:00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="map-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="map-container">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d27225.338882153355!2d74.25636264816069!3d31.46458205129889!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3919015f82b0b86f%3A0x2fcaf9fdeb3d02e6!2sJohar%20Town%2C%20Lahore%2C%20Pakistan!5e0!3m2!1sen!2s!4v1761659895458!5m2!1sen!2s"
                            allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header border-0 pt-4 pb-0">
                    <button type="button" class="btn-close position-absolute" style="right: 20px; top: 20px;" data-bs-dismiss="modal"></button>
                </div>
                
                <!-- Modal Body -->
                <div class="modal-body text-center px-5 py-4">
                    <!-- Success Icon -->
                    <div class="success-icon mb-4">
                        <div class="icon-circle bg-amber-light d-inline-flex align-items-center justify-content-center">
                            <i class="fas fa-paper-plane text-amber" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    
                    <!-- Title -->
                    <h3 class="modal-title mb-3 text-dark">Message Sent Successfully!</h3>
                    
                    <!-- Message -->
                    <p class="text-muted mb-4">
                        Thank you for reaching out to <span class="text-amber fw-semibold">Vircosa</span>. 
                        Your message has been received and our team will respond to your inquiry within 
                        <span class="fw-semibold">2 hours</span> during business hours.
                    </p>
                    
                    <!-- Confirmation Details -->
                    <div class="confirmation-details bg-light rounded p-4 mb-4">
                        <div class="row">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <div class="detail-item">
                                    <i class="fas fa-clock text-amber me-2"></i>
                                    <span class="text-muted">Response Time:</span>
                                    <span class="fw-semibold ms-1">Within 2 Hours</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <i class="fas fa-envelope text-amber me-2"></i>
                                    <span class="text-muted">Confirmation Sent To:</span>
                                    <span class="fw-semibold ms-1" id="userEmail"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Next Steps -->
                    <div class="next-steps text-start mb-4">
                        <h6 class="mb-3 text-dark">What happens next?</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span>You'll receive an email confirmation shortly</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-user-tie text-amber me-2"></i>
                                <span>Our customer care specialist will review your inquiry</span>
                            </li>
                            <li>
                                <i class="fas fa-headset text-amber me-2"></i>
                                <span>We'll contact you via your preferred method</span>
                            </li>
                        </ul>
                    </div>
                    
                    <!-- Action Buttons -->
                    <div class="modal-footer border-0 pt-3 justify-content-center">
                        <button type="button" class="btn btn-outline-amber me-3" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Close
                        </button>
                        <a href="/products" class="btn btn-amber">
                            <i class="fas fa-shopping-bag me-2"></i>Continue Shopping
                        </a>
                    </div>
                    
                    <!-- Support Note -->
                    <div class="support-note mt-4">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Need immediate assistance? Call us at <strong>+92 308 1036 864</strong>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/cta-section') %>
    <%- include('partials/newsletter', { req: req }) %>
    <%- include('partials/footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Main Scripts -->
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        // Check for success/error parameters and show modal
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            
            // Show success modal
            if (urlParams.get('success') === 'true') {
                const userEmail = urlParams.get('email');
                if (userEmail) {
                    document.getElementById('userEmail').textContent = decodeURIComponent(userEmail);
                }
                
                const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();
                
                // Add animation to icon
                setTimeout(() => {
                    const iconCircle = document.querySelector('.icon-circle');
                    if (iconCircle) {
                        iconCircle.style.transform = 'scale(1.1)';
                        setTimeout(() => {
                            iconCircle.style.transform = 'scale(1)';
                        }, 300);
                    }
                }, 100);
            }
            
            // Show error alert
            if (urlParams.get('error') === 'true') {
                document.getElementById('errorAlert').style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
            
            // Clean URL after modal is closed
            const successModal = document.getElementById('successModal');
            if (successModal) {
                successModal.addEventListener('hidden.bs.modal', function () {
                    if (window.history.replaceState && window.location.search) {
                        const newUrl = window.location.pathname;
                        window.history.replaceState({}, document.title, newUrl);
                    }
                });
            }
        });

        // Form submission with loading state
        const contactForm = document.getElementById('contactForm');
        const submitBtn = document.getElementById('submitBtn');
        
        if (contactForm) {
            contactForm.addEventListener('submit', function(e) {
                // Show loading state
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
                submitBtn.disabled = true;
                
                // Hide any previous error alerts
                document.getElementById('errorAlert').style.display = 'none';
            });
        }
    </script>
</body>

</html>