<!-- In your server-side template (EJS) -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | Vircosa</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #8B5A2B;
            --secondary-color: #4A2C2A;
            --accent-color: #D4AF8E;
            --light-color: #F8F5F2;
            --dark-color: #2A2118;
            --success-color: #28a745;
            --glass-bg: rgba(255, 255, 255, 0.9);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: linear-gradient(135deg, #F8F5F2 0%, #F0EBE6 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .forgot-password-container {
            width: 100%;
            max-width: 500px;
            animation: fadeInUp 0.6s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .logo-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            color: var(--secondary-color);
            margin-bottom: 10px;
        }

        .logo-header span {
            color: var(--primary-color);
        }

        .forgot-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border-radius: 28px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(139, 90, 43, 0.1);
            border: 1px solid rgba(139, 90, 43, 0.1);
            position: relative;
            overflow: hidden;
        }

        .forgot-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
            border-radius: 28px 28px 0 0;
        }

        .card-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .card-header i {
            font-size: 4rem;
            color: var(--primary-color);
            margin-bottom: 20px;
            display: inline-block;
            background: linear-gradient(135deg, rgba(139, 90, 43, 0.1), rgba(212, 175, 142, 0.1));
            width: 100px;
            height: 100px;
            line-height: 100px;
            border-radius: 50%;
            animation: iconFloat 3s ease-in-out infinite;
        }

        @keyframes iconFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .card-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--secondary-color);
            margin-bottom: 10px;
        }

        .card-header p {
            color: #666;
            font-size: 1rem;
        }

        .support-info {
            background: linear-gradient(135deg, rgba(139, 90, 43, 0.05), rgba(212, 175, 142, 0.05));
            border-radius: 20px;
            padding: 25px;
            margin: 30px 0;
            border-left: 4px solid var(--accent-color);
        }

        .support-info h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.2rem;
            color: var(--secondary-color);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .support-info h3 i {
            color: var(--primary-color);
        }

        .support-details {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .support-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .support-item:hover {
            background: white;
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(139, 90, 43, 0.1);
        }

        .support-item i {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .support-text {
            flex: 1;
        }

        .support-text .label {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 3px;
        }

        .support-text .value {
            font-size: 1.1rem;
            color: var(--secondary-color);
            font-weight: 600;
        }

        .instructions {
            background: linear-gradient(135deg, rgba(40, 167, 69, 0.05), rgba(40, 167, 69, 0.1));
            border-radius: 20px;
            padding: 25px;
            margin: 25px 0;
            border: 2px solid rgba(40, 167, 69, 0.2);
        }

        .instructions h4 {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.2rem;
            color: var(--success-color);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .instructions ul {
            list-style: none;
            padding-left: 0;
        }

        .instructions li {
            padding: 10px 0 10px 35px;
            position: relative;
            color: #666;
            line-height: 1.6;
        }

        .instructions li::before {
            content: '✓';
            position: absolute;
            left: 0;
            top: 10px;
            width: 24px;
            height: 24px;
            background: var(--success-color);
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 15px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
            flex: 1;
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(139, 90, 43, 0.3);
            color: white;
        }

        .btn-secondary-custom {
            background: rgba(139, 90, 43, 0.1);
            color: var(--primary-color);
            border: 1px solid rgba(139, 90, 43, 0.2);
            padding: 15px 30px;
            border-radius: 15px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
            flex: 1;
        }

        .btn-secondary-custom:hover {
            background: rgba(139, 90, 43, 0.2);
            transform: translateY(-3px);
            color: var(--primary-color);
        }

        .security-note {
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 193, 7, 0.1);
            border-radius: 12px;
            text-align: center;
            color: #856404;
            font-size: 0.9rem;
            border: 1px solid rgba(255, 193, 7, 0.2);
        }

        .security-note i {
            color: #ffc107;
            margin-right: 5px;
        }

        .response-time {
            margin-top: 20px;
            text-align: center;
            color: #666;
            font-size: 0.9rem;
            padding: 12px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 12px;
            border: 1px dashed rgba(139, 90, 43, 0.3);
        }

        .response-time .highlight {
            color: var(--primary-color);
            font-weight: 600;
        }

        /* Animation for email link */
        .support-item.email-link {
            cursor: pointer;
            position: relative;
        }

        .support-item.email-link:hover i {
            animation: emailShake 0.5s ease;
        }

        @keyframes emailShake {
            0%, 100% { transform: rotate(0); }
            25% { transform: rotate(-10deg); }
            75% { transform: rotate(10deg); }
        }

        /* Responsive Design */
        @media (max-width: 576px) {
            .forgot-card {
                padding: 25px;
                border-radius: 24px;
            }

            .card-header i {
                font-size: 3rem;
                width: 80px;
                height: 80px;
                line-height: 80px;
            }

            .card-header h2 {
                font-size: 1.8rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .support-item {
                padding: 10px;
            }
        }

        /* Print Styles */
        @media print {
            .action-buttons,
            .btn-primary-custom,
            .btn-secondary-custom {
                display: none;
            }

            .forgot-card {
                box-shadow: none;
                border: 2px solid #ddd;
            }
        }
    </style>
</head>
<body>
    <div class="forgot-password-container">
        <div class="logo-header">
            <h1>Vir<span>cosa</span></h1>
            <p>Luxury Fragrances</p>
        </div>

        <div class="forgot-card">
            <div class="card-header">
                <i class="fas fa-key"></i>
                <h2>Password Assistance</h2>
                <p>We're here to help you regain access to your account</p>
            </div>

            <div class="support-info">
                <h3><i class="fas fa-headset"></i> Contact Our Support Team</h3>
                <div class="support-details">
                    <div class="support-item email-link" onclick="copyToClipboard('support@vircosa.com')">
                        <i class="fas fa-envelope"></i>
                        <div class="support-text">
                            <div class="label">Email Address</div>
                            <div class="value">support@vircosa.com</div>
                        </div>
                        <i class="fas fa-copy" style="color: var(--primary-color); font-size: 1rem;"></i>
                    </div>
                    <div class="support-item">
                        <i class="fas fa-clock"></i>
                        <div class="support-text">
                            <div class="label">Support Hours</div>
                            <div class="value">Monday - Friday: 9 AM - 6 PM (PKT)</div>
                        </div>
                    </div>
                    <div class="support-item">
                        <i class="fas fa-phone"></i>
                        <div class="support-text">
                            <div class="label">Phone Support</div>
                            <div class="value">+92 300 123 4567</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="instructions">
                <h4><i class="fas fa-lightbulb"></i> What to Include in Your Email</h4>
                <ul>
                    <li>Your registered email address</li>
                    <li>Full name associated with the account</li>
                    <li>Any recent order number (if available)</li>
                    <li>Brief description of the issue</li>
                    <li>Preferred callback time (if phone support needed)</li>
                </ul>
            </div>

            <div class="response-time">
                <i class="fas fa-bolt"></i> Typical response time: <span class="highlight">Within 2 business hours</span>
            </div>

            <div class="action-buttons">
                <a href="mailto:support@vircosa.com?subject=Password%20Assistance%20Request&body=Hello%20Vircosa%20Support%2C%0A%0AI%20need%20assistance%20with%20resetting%20my%20password.%0A%0ARegistered%20Email%3A%0AFull%20Name%3A%0A%0AThank%20you." 
                   class="btn-primary-custom">
                    <i class="fas fa-envelope"></i> Send Email Now
                </a>
                <a href="/login" class="btn-secondary-custom">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>
            </div>

            <div class="security-note">
                <i class="fas fa-shield-alt"></i>
                For security reasons, we don't handle password resets through automated systems. 
                Our team will verify your identity before assisting with account recovery.
            </div>
        </div>
    </div>

    <script>
        // Copy email to clipboard
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                // Show success feedback
                const emailItem = document.querySelector('.support-item.email-link');
                const copyIcon = emailItem.querySelector('.fa-copy');
                
                // Change icon temporarily
                const originalIcon = copyIcon.className;
                copyIcon.className = 'fas fa-check';
                copyIcon.style.color = 'var(--success-color)';
                
                // Add success animation
                emailItem.style.background = 'rgba(40, 167, 69, 0.1)';
                emailItem.style.borderLeft = '4px solid var(--success-color)';
                
                // Revert after 2 seconds
                setTimeout(() => {
                    copyIcon.className = originalIcon;
                    copyIcon.style.color = 'var(--primary-color)';
                    emailItem.style.background = '';
                    emailItem.style.borderLeft = '';
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        }

        // Add click handler for email item
        document.querySelector('.support-item.email-link').addEventListener('click', function(e) {
            if (!e.target.closest('.btn-primary-custom')) {
                copyToClipboard('support@vircosa.com');
            }
        });

        // Smooth scroll animation for page load
        document.addEventListener('DOMContentLoaded', () => {
            document.body.style.opacity = 0;
            document.body.style.transition = 'opacity 0.5s ease';
            
            setTimeout(() => {
                document.body.style.opacity = 1;
            }, 100);
        });

        // Keyboard shortcut for copying email
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'c') {
                const activeElement = document.activeElement;
                if (!activeElement || activeElement.tagName !== 'INPUT') {
                    copyToClipboard('support@vircosa.com');
                }
            }
        });
    </script>
</body>
</html>