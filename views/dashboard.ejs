    <!-- Reviews Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Filter reviews
            const filterButtons = document.querySelectorAll('.filter-buttons .btn');
            const reviewCards = document.querySelectorAll('.reviews-grid .col-lg-6');
            
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Update active button
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    const filter = this.getAttribute('data-filter');
                    
                    reviewCards.forEach(card => {
                        const rating = parseInt(card.getAttribute('data-rating'));
                        const date = parseInt(card.getAttribute('data-date'));
                        const now = Date.now();
                        const thirtyDaysAgo = now - (30 * 24 * 60 * 60 * 1000);
                        
                        let show = true;
                        
                        switch(filter) {
                            case 'all':
                                show = true;
                                break;
                            case '5':
                                show = rating === 5;
                                break;
                            case '4':
                                show = rating >= 4;
                                break;
                            case 'recent':
                                show = date >= thirtyDaysAgo;
                                break;
                        }
                        
                        card.style.display = show ? 'block' : 'none';
                    });
                });
            });
            
            // Sort reviews
            const sortSelect = document.getElementById('sortReviews');
            if (sortSelect) {
                sortSelect.addEventListener('change', function() {
                    const sortBy = this.value;
                    const reviewsContainer = document.querySelector('.reviews-grid .row');
                    const reviewItems = Array.from(reviewsContainer.children);
                    
                    reviewItems.sort((a, b) => {
                        const ratingA = parseInt(a.getAttribute('data-rating'));
                        const ratingB = parseInt(b.getAttribute('data-rating'));
                        const dateA = parseInt(a.getAttribute('data-date'));
                        const dateB = parseInt(b.getAttribute('data-date'));
                        
                        switch(sortBy) {
                            case 'newest':
                                return dateB - dateA;
                            case 'oldest':
                                return dateA - dateB;
                            case 'highest':
                                return ratingB - ratingA;
                            case 'lowest':
                                return ratingA - ratingB;
                            default:
                                return 0;
                        }
                    });
                    
                    // Reorder reviews
                    reviewItems.forEach(item => {
                        reviewsContainer.appendChild(item);
                    });
                });
            }
            
            // Edit review
            const editButtons = document.querySelectorAll('.edit-review');
            editButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const reviewId = this.getAttribute('data-review-id');
                    // In a real implementation, this would open an edit modal
                    alert('Edit functionality for review ' + reviewId + ' would open here');
                });
            });
            
            // Delete review
            const deleteButtons = document.querySelectorAll('.delete-review');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const reviewId = this.getAttribute('data-review-id');
                    
                    if (confirm('Are you sure you want to delete this review? This action cannot be undone.')) {
                        // In a real implementation, this would make a DELETE request
                        const card = this.closest('.col-lg-6');
                        card.style.opacity = '0.5';
                        
                        setTimeout(() => {
                            card.remove();
                            // Show message if no reviews left
                            if (document.querySelectorAll('.reviews-grid .col-lg-6').length === 0) {
                                location.reload(); // Reload to show empty state
                            }
                        }, 500);
                        
                        alert('Review deleted successfully');
                    }
                });
            });
            
            // Load more reviews
            const loadMoreBtn = document.getElementById('loadMoreReviews');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    // Simulate loading more reviews
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Loading...';
                    this.disabled = true;
                    
                    setTimeout(() => {
                        this.innerHTML = '<i class="fas fa-check me-2"></i>All Reviews Loaded';
                        this.classList.remove('btn-outline-amber');
                        this.classList.add('btn-secondary');
                    }, 1500);
                });
            }
        });
    </script>

    <!-- Recent Orders -->
    <script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    // Reorder functionality
    const reorderButtons = document.querySelectorAll('[title="Reorder"]');
    reorderButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const orderItem = this.closest('.order-item');
            const orderTitle = orderItem.querySelector('.order-title').textContent;
            
            // In a real implementation, this would add items to cart
            if (confirm(`Reorder "${orderTitle.trim()}"? This will add all items to your cart.`)) {
                // Show loading state
                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                this.disabled = true;
                
                // Simulate API call
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-check"></i>';
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-success');
                    
                    // Show success message
                    const toast = document.createElement('div');
                    toast.className = 'position-fixed bottom-0 end-0 p-3';
                    toast.innerHTML = `
                        <div class="toast show" role="alert">
                            <div class="toast-header bg-success text-white">
                                <strong class="me-auto">Success!</strong>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                            </div>
                            <div class="toast-body">
                                Items added to cart. <a href="/cart" class="text-decoration-none">View cart</a>
                            </div>
                        </div>
                    `;
                    document.body.appendChild(toast);
                    
                    // Remove toast after 3 seconds
                    setTimeout(() => {
                        toast.remove();
                    }, 3000);
                }, 1500);
            }
        });
    });
    
    // Hover effect enhancement
    const orderItems = document.querySelectorAll('.order-item');
    orderItems.forEach(item => {
        item.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.transition = 'transform 0.2s ease';
        });
        
        item.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
        });
    });
});
</script>
