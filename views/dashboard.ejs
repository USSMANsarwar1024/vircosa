<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vircosa | Luxury Fragrances</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts (Playfair Display + Montserrat) -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../stylesheets/navbar-styles.css">
    <link rel="stylesheet" href="../stylesheets/footer-styles.css">
    <link rel="stylesheet" href="../stylesheets/main-styles.css">
    <link rel="stylesheet" href="../stylesheets/cta-section-styles.css">
    <link rel="stylesheet" href="../stylesheets/newsletter-styles.css">

    <style>
        .hero-section {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../images/dashboard-hero-img.png');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            color: white;
            padding: 120px 0;
            margin-bottom: 50px;
        }

        .perfume-card {
            transition: transform 0.3s, box-shadow 0.3s;
            border: none;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .perfume-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .card-img-top {
            height: 250px;
            object-fit: cover;
        }

        .badge-sale {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: #e53935;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .price {
            font-weight: 600;
            color: var(--primary-color);
        }

        .old-price {
            text-decoration: line-through;
            color: #999;
            font-size: 0.9rem;
        }

        .marquee {
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        }

        .marquee-content {
        display: inline-flex;
        gap: 1.5rem;
        animation: scrollLeft 40s linear infinite;
        }

        .marquee-content .card {
        flex: 0 0 auto;
        width: 300px;
        }

        .marquee-content:hover {
        animation-play-state: paused;
    }

        @keyframes scrollLeft {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
        }

        /* Responsive: on small screens, stop animation and stack horizontally */
        @media (max-width: 768px) {
        .marquee {
            overflow-x: auto;
            white-space: nowrap;
        }
        .marquee-content {
            animation: none;
            display: flex;
            gap: 1rem;
        }
        .marquee-content .card {
            width: 220px;
        }
        }


        .dashboard-card {
            border-radius: 10px;
            border: none;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s;
            height: 100%;
        }

        .dashboard-card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .dashboard-icon {
            font-size: 2rem;
            color: var(--accent-color);
            margin-bottom: 15px;
        }

        .section-title {
            position: relative;
            margin-bottom: 40px;
            font-weight: 700;
            color: var(--primary-color);
        }

        .section-title:after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 50px;
            height: 3px;
            background-color: var(--accent-color);
        }

        .review-card {
            border-left: 4px solid var(--accent-color);
        }

        .star-rating {
            color: #ffc107;
        }

        .footer {
            background-color: var(--dark-color);
            color: white;
            padding: 50px 0 20px;
        }

        .footer-links a {
            color: var(--secondary-color);
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: white;
        }

        .newsletter-input {
            background-color: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
        }

        .newsletter-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .btn-zephyra {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 25px;
            transition: all 0.3s;
        }

        .btn-zephyra:hover {
            background-color: var(--dark-color);
            color: white;
            transform: translateY(-2px);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            padding: 20px;
        }

        .sidebar-link {
            color: var(--dark-color);
            text-decoration: none;
            display: block;
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            background-color: var(--secondary-color);
            color: var(--primary-color);
        }

        .sidebar-link i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .purchase-history-item {
            border-bottom: 1px solid #eee;
            padding: 15px 0;
        }

        .purchase-history-item:last-child {
            border-bottom: none;
        }
        
    </style>

    <!-- Dashboard Reviews Styles  -->
    <style>
        .reviews-dashboard-section {
            padding: 2rem 0;
        }

        .dashboard-title {
            color: var(--secondary-color);
            font-weight: 700;
            font-size: 1.8rem;
        }

        .dashboard-subtitle {
            font-size: 1rem;
        }

        /* Color Variables */
        :root {
            --amber: #8B5A2B;
            --amber-light: #D4AF8E;
            --amber-lighter: #F8F5F2;
            --secondary-color: #4A2C2A;
        }

        .text-amber { color: var(--amber) !important; }
        .bg-amber { background-color: var(--amber) !important; }
        .bg-amber-light { background-color: var(--amber-lighter) !important; }
        .btn-amber { 
            background-color: var(--amber); 
            border-color: var(--amber);
            color: white;
        }
        .btn-amber:hover {
            background-color: #7a4d24;
            border-color: #7a4d24;
            color: white;
        }
        .btn-outline-amber {
            color: var(--amber);
            border-color: var(--amber);
        }
        .btn-outline-amber:hover {
            background-color: var(--amber);
            color: white;
        }

        /* Empty State */
        .empty-reviews-state {
            background: linear-gradient(135deg, var(--amber-lighter) 0%, #ffffff 100%);
            border-radius: 20px;
            border: 2px dashed var(--amber-light);
        }

        /* Stats Cards */
        .stat-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(139, 90, 43, 0.1);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
        }

        /* Review Cards */
        .review-card {
            transition: all 0.3s ease;
            border-radius: 15px;
            overflow: hidden;
        }

        .review-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(139, 90, 43, 0.15) !important;
        }

        .product-header {
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 1rem;
        }

        .product-category {
            font-size: 0.7rem;
            padding: 4px 8px;
        }

        .star-rating .fa-star {
            font-size: 0.9rem;
        }

        .text-light {
            color: #e0e0e0 !important;
        }

        .review-title {
            font-style: italic;
            color: var(--secondary-color);
        }

        .review-comment {
            line-height: 1.6;
            color: #555;
        }

        .review-actions {
            border-top: 1px solid #f0f0f0;
        }

        /* Filter Buttons */
        .filter-buttons .btn {
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 20px;
            font-weight: 500;
        }

        .filter-buttons .btn.active {
            background-color: var(--amber);
            color: white;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .reviews-stats .col-md-3 {
                margin-bottom: 1rem;
            }
            
            .stat-card {
                padding: 1rem !important;
            }
            
            .stat-number {
                font-size: 1.5rem !important;
            }
            
            .filter-buttons {
                text-align: center;
                margin-bottom: 1rem;
            }
            
            .reviews-controls .text-md-end {
                text-align: left !important;
            }
        }

        @media (max-width: 576px) {
            .review-card .review-actions {
                flex-direction: column;
                gap: 10px;
                align-items: flex-start;
            }
            
            .review-stats {
                align-self: flex-end;
            }
        }
    </style>

<!-- Recent Orders Styles  -->
    <style>
.recent-orders-section {
    margin-bottom: 2rem;
}

.card-title {
    color: var(--secondary-color);
    font-weight: 600;
}

/* Color Variables */
:root {
    --amber: #8B5A2B;
    --amber-light: #D4AF8E;
    --amber-lighter: #F8F5F2;
    --secondary-color: #4A2C2A;
}

.text-amber { color: var(--amber) !important; }
.btn-amber { 
    background-color: var(--amber); 
    border-color: var(--amber);
    color: white;
}
.btn-amber:hover {
    background-color: #7a4d24;
    border-color: #7a4d24;
    color: white;
}
.btn-outline-amber {
    color: var(--amber);
    border-color: var(--amber);
}
.btn-outline-amber:hover {
    background-color: var(--amber);
    color: white;
}

/* Order Items */
.order-item {
    padding: 1rem 0;
    transition: background-color 0.2s ease;
}

.order-item:hover {
    background-color: var(--amber-lighter);
    border-radius: 10px;
    padding: 1rem;
    margin: 0 -1rem;
}

/* Image Stack */
.image-stack {
    position: relative;
    width: 60px;
    height: 60px;
}

.stacked-image {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.stacked-image:nth-child(2) {
    left: 10px;
    top: 5px;
}

.stacked-image:nth-child(3) {
    left: 20px;
    top: 10px;
}

.stacked-count {
    position: absolute;
    left: 40px;
    top: 10px;
    width: 40px;
    height: 40px;
    background-color: var(--amber);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(139, 90, 43, 0.3);
}

/* Status Badges */
.status-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
}

.status-delivered {
    background-color: rgba(40, 167, 69, 0.1);
    color: #28a745;
    border: 1px solid rgba(40, 167, 69, 0.2);
}

.status-confirmed {
    background-color: rgba(23, 162, 184, 0.1);
    color: #17a2b8;
    border: 1px solid rgba(23, 162, 184, 0.2);
}

.status-shipped {
    background-color: rgba(0, 123, 255, 0.1);
    color: #007bff;
    border: 1px solid rgba(0, 123, 255, 0.2);
}

.status-pending {
    background-color: rgba(255, 193, 7, 0.1);
    color: #856404;
    border: 1px solid rgba(255, 193, 7, 0.2);
}

.status-cancelled {
    background-color: rgba(220, 53, 69, 0.1);
    color: #dc3545;
    border: 1px solid rgba(220, 53, 69, 0.2);
}

/* Order Stats */
.orders-stats {
    background-color: var(--amber-lighter);
    border-radius: 15px;
    padding: 1.5rem;
}

.stat-item {
    padding: 0.5rem;
}

.stat-number {
    font-size: 1.5rem;
    font-family: 'Playfair Display', serif;
}

.stat-label {
    font-size: 0.85rem;
    margin-top: 5px;
}

/* Empty State */
.empty-orders {
    background: linear-gradient(135deg, var(--amber-lighter) 0%, #ffffff 100%);
    border-radius: 20px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .order-item .row > div {
        margin-bottom: 1rem;
    }
    
    .order-details .order-title {
        font-size: 1rem;
    }
    
    .order-actions {
        display: flex;
        justify-content: flex-start;
        gap: 10px;
        margin-top: 10px;
    }
    
    .orders-stats .col-md-3 {
        margin-bottom: 1rem;
    }
    
    .status-badge {
        padding: 4px 8px;
        font-size: 0.8rem;
    }
}

@media (max-width: 576px) {
    .order-item {
        padding: 0.75rem;
        margin: 0 -0.75rem !important;
    }
    
    .order-images .image-stack {
        transform: scale(0.9);
        transform-origin: left center;
    }
    
    .order-details {
        margin-left: -10px;
    }
}
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <h1 class="display-3 brand-font mb-4">Welcome back, 
                <% if (user.gender === 'm') 
                    { %> Mr. <%= user.lastname %> <% } 
                else if (user.gender === 'f') 
                    { %> Ms. <%= user.lastname %> <% } 
                else 
                    { %> <%= user.firstname || user.lastname %> 
                <% } %> 
                <span id="emoji"></span> 
            </h1>
            
            <p class="lead mb-5" style="max-width: 45rem; margin: 0 auto; opacity: 0.9;">Rediscover your individuality through scents that speak your story. <br>Every fragrance in <strong>Vircosa</strong> is a reflection of timeless elegance and personal allure. </p>
            <a href="/products" class="btn btn-zephyra btn-lg">Explore Collection</a>
        </div>
    </section>


    <!-- Dashboard Section -->
    <section id="dashboard" class="py-5 bg-light">
        <div class="container">
            <h2 class="section-title brand-font">Your Dashboard</h2>

            <div class="row">
                <div class="col-lg-3 mb-4">
                    <div class="sidebar">
                        <div class="d-flex align-items-center mb-4">
                            <img src="https://randomuser.me/api/portraits/women/45.jpg" alt="User"
                                class="user-avatar me-3">
                            <div>
                                <h6 class="mb-0">
                                    <%= user.firstname %> <%= user.lastname %>
                                </h6>

                            </div>
                        </div>

                        <a href="/dashboard" class="sidebar-link active">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                        <a href="/dashboard/orders" class="sidebar-link">
                            <i class="fas fa-shopping-bag"></i> Orders
                        </a>
                        <a href="/wishlist" class="sidebar-link">
                            <i class="fas fa-heart"></i> Wishlist
                        </a>
                        <a href="/track-order" class="sidebar-link">
                            <i class="fas fa-star"></i> Track Orders
                        </a>
                        <a href="#" class="sidebar-link">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                        <a href="/logout" id="logoutBtn" class="sidebar-link">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="row mb-4">
                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-shopping-bag"></i>
                                </div>
                                <h5><%= totalOrders %></h5>
                                <p class="text-muted mb-0">Total Orders</p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-heart"></i>
                                </div>
                                <h5><%= user.wishlist.length %></h5>
                                <p class="text-muted mb-0">Wishlist Items</p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-star"></i>
                                </div>
                                <h5><%= myReviews.length %></h5>
                                <p class="text-muted mb-0">Reviews</p>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Orders -->
                    <div class="recent-orders-section">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-0 pb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-box-open text-amber me-2"></i>Recent Orders
                                    </h5>
                                    <a href="/dashboard/orders" class="btn btn-link text-amber p-0">
                                        View All <i class="fas fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>

                            <% if (orders && orders.length > 0) { %>
                                <div class="card-body pt-0">
                                    <div class="orders-list">
                                        <% orders.slice(0, 5).forEach((order, index) => { %>
                                        <div class="order-item <%= index < orders.slice(0, 5).length - 1 ? 'border-bottom pb-3 mb-3' : '' %>">
                                            <div class="row align-items-center">
                                                <!-- Order Summary -->
                                                <div class="col-md-6">
                                                    <div class="d-flex">
                                                        <!-- Product Images -->
                                                        <div class="order-images me-3">
                                                            <div class="image-stack">
                                                                <% order.items.slice(0, 3).forEach((item, imgIndex) => { %>
                                                                    <div class="stacked-image" style="z-index: <%= 3 - imgIndex %>;">
                                                                        <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                                                                            <img src="<%= item.product.images[0] %>" 
                                                                                alt="<%= item.name %>" 
                                                                                class="img-fluid rounded"
                                                                                style="width: 60px; height: 60px; object-fit: cover; border: 2px solid white;">
                                                                        <% } else { %>
                                                                            <img src="/images/placeholder-product.jpg" 
                                                                                alt="Product" 
                                                                                class="img-fluid rounded"
                                                                                style="width: 60px; height: 60px; object-fit: cover; border: 2px solid white;">
                                                                        <% } %>
                                                                    </div>
                                                                <% }); %>
                                                                <% if (order.items.length > 3) { %>
                                                                    <div class="stacked-count">
                                                                        <span>+<%= order.items.length - 3 %></span>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>

                                                        <!-- Order Details -->
                                                        <div class="order-details">
                                                            <h6 class="order-title mb-1">
                                                                <%= order.items[0].name %>
                                                                <% if (order.items.length > 1) { %>
                                                                    <span class="text-muted">+ <%= order.items.length - 1 %> more</span>
                                                                <% } %>
                                                            </h6>
                                                            <p class="order-meta text-muted mb-2">
                                                                <small>
                                                                    <i class="far fa-calendar me-1"></i>
                                                                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { 
                                                                        month: 'short', 
                                                                        day: 'numeric', 
                                                                        year: 'numeric' 
                                                                    }) %>
                                                                    • 
                                                                    <i class="fas fa-hashtag me-1"></i>
                                                                    <%= order.orderNumber %>
                                                                </small>
                                                            </p>
                                                            <p class="order-total mb-0">
                                                                <strong class="text-dark">PKR <%= order.totalAmount.toFixed(2) %></strong>
                                                                <span class="text-muted ms-2">
                                                                    • <%= order.items.length %> item<%= order.items.length > 1 ? 's' : '' %>
                                                                </span>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Status & Actions -->
                                                <div class="col-md-6">
                                                    <div class="d-flex justify-content-between align-items-center h-100">
                                                        <!-- Status -->
                                                        <div class="order-status">
                                                            <%
                                                                let statusClass = '';
                                                                let statusIcon = 'fa-clock';
                                                                
                                                                if (order.orderStatus === 'delivered') {
                                                                    statusClass = 'status-delivered';
                                                                    statusIcon = 'fa-check-circle';
                                                                } else if (order.orderStatus === 'confirmed') {
                                                                    statusClass = 'status-confirmed';
                                                                    statusIcon = 'fa-check';
                                                                } else if (order.orderStatus === 'shipped') {
                                                                    statusClass = 'status-shipped';
                                                                    statusIcon = 'fa-shipping-fast';
                                                                } else if (order.orderStatus === 'pending') {
                                                                    statusClass = 'status-pending';
                                                                    statusIcon = 'fa-hourglass-half';
                                                                } else if (order.orderStatus === 'cancelled') {
                                                                    statusClass = 'status-cancelled';
                                                                    statusIcon = 'fa-times-circle';
                                                                }
                                                            %>
                                                            <div class="status-badge <%= statusClass %>">
                                                                <i class="fas <%= statusIcon %> me-2"></i>
                                                                <span class="text-capitalize"><%= order.orderStatus %></span>
                                                            </div>
                                                            <small class="text-muted d-block mt-1">
                                                                <% if (order.estimatedDelivery) { %>
                                                                    Est. delivery: <%= new Date(order.estimatedDelivery).toLocaleDateString('en-US', { 
                                                                        month: 'short', 
                                                                        day: 'numeric' 
                                                                    }) %>
                                                                <% } %>
                                                            </small>
                                                        </div>

                                                        <!-- Actions -->
                                                        <div class="order-actions">
                                                            <a href="/dashboard/orders/<%= order._id %>" 
                                                            class="btn btn-sm btn-outline-amber">
                                                                View Details
                                                            </a>
                                                            <% if (order.orderStatus === 'delivered') { %>
                                                                <button class="btn btn-sm btn-outline-secondary ms-2" 
                                                                        data-bs-toggle="tooltip" 
                                                                        title="Reorder">
                                                                    <i class="fas fa-redo"></i>
                                                                </button>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                    </div>

                                    <!-- Quick Stats -->
                                    <div class="orders-stats mt-4 pt-3 border-top">
                                        <div class="row">
