<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vircosa | Luxury Fragrances</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts (Playfair Display + Montserrat) -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../stylesheets/navbar-styles.css">
    <link rel="stylesheet" href="../stylesheets/footer-styles.css">
    <link rel="stylesheet" href="../stylesheets/main-styles.css">
    <link rel="stylesheet" href="../stylesheets/cta-section-styles.css">
    <link rel="stylesheet" href="../stylesheets/newsletter-styles.css">

    <style>
        .hero-section {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../images/dashboard-hero-img.png');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            color: white;
            padding: 120px 0;
            margin-bottom: 50px;
        }

        .perfume-card {
            transition: transform 0.3s, box-shadow 0.3s;
            border: none;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .perfume-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .card-img-top {
            height: 250px;
            object-fit: cover;
        }

        .badge-sale {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: #e53935;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .price {
            font-weight: 600;
            color: var(--primary-color);
        }

        .old-price {
            text-decoration: line-through;
            color: #999;
            font-size: 0.9rem;
        }

        .marquee {
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        }

        .marquee-content {
        display: inline-flex;
        gap: 1.5rem;
        animation: scrollLeft 40s linear infinite;
        }

        .marquee-content .card {
        flex: 0 0 auto;
        width: 300px;
        }

        .marquee-content:hover {
        animation-play-state: paused;
    }

        @keyframes scrollLeft {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
        }

        /* Responsive: on small screens, stop animation and stack horizontally */
        @media (max-width: 768px) {
        .marquee {
            overflow-x: auto;
            white-space: nowrap;
        }
        .marquee-content {
            animation: none;
            display: flex;
            gap: 1rem;
        }
        .marquee-content .card {
            width: 220px;
        }
        }


        .dashboard-card {
            border-radius: 10px;
            border: none;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s;
            height: 100%;
        }

        .dashboard-card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .dashboard-icon {
            font-size: 2rem;
            color: var(--accent-color);
            margin-bottom: 15px;
        }

        .section-title {
            position: relative;
            margin-bottom: 40px;
            font-weight: 700;
            color: var(--primary-color);
        }

        .section-title:after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 50px;
            height: 3px;
            background-color: var(--accent-color);
        }

        .review-card {
            border-left: 4px solid var(--accent-color);
        }

        .star-rating {
            color: #ffc107;
        }

        .footer {
            background-color: var(--dark-color);
            color: white;
            padding: 50px 0 20px;
        }

        .footer-links a {
            color: var(--secondary-color);
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: white;
        }

        .newsletter-input {
            background-color: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
        }

        .newsletter-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .btn-zephyra {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 25px;
            transition: all 0.3s;
        }

        .btn-zephyra:hover {
            background-color: var(--dark-color);
            color: white;
            transform: translateY(-2px);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            padding: 20px;
        }

        .sidebar-link {
            color: var(--dark-color);
            text-decoration: none;
            display: block;
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            background-color: var(--secondary-color);
            color: var(--primary-color);
        }

        .sidebar-link i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .purchase-history-item {
            border-bottom: 1px solid #eee;
            padding: 15px 0;
        }

        .purchase-history-item:last-child {
            border-bottom: none;
        }
        
    </style>

    <!-- Dashboard Reviews Styles  -->
    <style>
        .reviews-dashboard-section {
            padding: 2rem 0;
        }

        .dashboard-title {
            color: var(--secondary-color);
            font-weight: 700;
            font-size: 1.8rem;
        }

        .dashboard-subtitle {
            font-size: 1rem;
        }

        /* Color Variables */
        :root {
            --amber: #8B5A2B;
            --amber-light: #D4AF8E;
            --amber-lighter: #F8F5F2;
            --secondary-color: #4A2C2A;
        }

        .text-amber { color: var(--amber) !important; }
        .bg-amber { background-color: var(--amber) !important; }
        .bg-amber-light { background-color: var(--amber-lighter) !important; }
        .btn-amber { 
            background-color: var(--amber); 
            border-color: var(--amber);
            color: white;
        }
        .btn-amber:hover {
            background-color: #7a4d24;
            border-color: #7a4d24;
            color: white;
        }
        .btn-outline-amber {
            color: var(--amber);
            border-color: var(--amber);
        }
        .btn-outline-amber:hover {
            background-color: var(--amber);
            color: white;
        }

        /* Empty State */
        .empty-reviews-state {
            background: linear-gradient(135deg, var(--amber-lighter) 0%, #ffffff 100%);
            border-radius: 20px;
            border: 2px dashed var(--amber-light);
        }

        /* Stats Cards */
        .stat-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(139, 90, 43, 0.1);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
        }

        /* Review Cards */
        .review-card {
            transition: all 0.3s ease;
            border-radius: 15px;
            overflow: hidden;
        }

        .review-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(139, 90, 43, 0.15) !important;
        }

        .product-header {
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 1rem;
        }

        .product-category {
            font-size: 0.7rem;
            padding: 4px 8px;
        }

        .star-rating .fa-star {
            font-size: 0.9rem;
        }

        .text-light {
            color: #e0e0e0 !important;
        }

        .review-title {
            font-style: italic;
            color: var(--secondary-color);
        }

        .review-comment {
            line-height: 1.6;
            color: #555;
        }

        .review-actions {
            border-top: 1px solid #f0f0f0;
        }

        /* Filter Buttons */
        .filter-buttons .btn {
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 20px;
            font-weight: 500;
        }

        .filter-buttons .btn.active {
            background-color: var(--amber);
            color: white;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .reviews-stats .col-md-3 {
                margin-bottom: 1rem;
            }
            
            .stat-card {
                padding: 1rem !important;
            }
            
            .stat-number {
                font-size: 1.5rem !important;
            }
            
            .filter-buttons {
                text-align: center;
                margin-bottom: 1rem;
            }
            
            .reviews-controls .text-md-end {
                text-align: left !important;
            }
        }

        @media (max-width: 576px) {
            .review-card .review-actions {
                flex-direction: column;
                gap: 10px;
                align-items: flex-start;
            }
            
            .review-stats {
                align-self: flex-end;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <h1 class="display-3 brand-font mb-4">Welcome back, 
                <% if (user.gender === 'm') { %> Mr. <%= user.lastname %> <% } else if (user.gender === 'f') { %> Ms. <%= user.lastname %> <% } else { %> <%= user.lastname %> <% } %> <span id="emoji"></span> 
            </h1>
            
            <p class="lead mb-5" style="max-width: 45rem; margin: 0 auto; opacity: 0.9;">Rediscover your individuality through scents that speak your story. <br>Every fragrance in <strong>Vircosa</strong> is a reflection of timeless elegance and personal allure. </p>
            <a href="/perfumes" class="btn btn-zephyra btn-lg">Explore Collection</a>
        </div>
    </section>

    <%- include('partials/perfume-partials') %>

    <!-- Dashboard Section -->
    <section id="dashboard" class="py-5 bg-light">
        <div class="container">
            <h2 class="section-title brand-font">Your Dashboard</h2>

            <div class="row">
                <div class="col-lg-3 mb-4">
                    <div class="sidebar">
                        <div class="d-flex align-items-center mb-4">
                            <img src="https://randomuser.me/api/portraits/women/45.jpg" alt="User"
                                class="user-avatar me-3">
                            <div>
                                <h6 class="mb-0">
                                    <%= user.firstname %> <%= user.lastname %>
                                </h6>

                            </div>
                        </div>

                        <a href="/dashboard" class="sidebar-link active">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                        <a href="/dashboard/orders" class="sidebar-link">
                            <i class="fas fa-shopping-bag"></i> Orders
                        </a>
                        <a href="/wishlist" class="sidebar-link">
                            <i class="fas fa-heart"></i> Wishlist
                        </a>
                        <a href="#reviews" class="sidebar-link">
                            <i class="fas fa-star"></i> Reviews
                        </a>
                        <a href="#" class="sidebar-link">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                        <a href="/logout" id="logoutBtn" class="sidebar-link">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="row mb-4">
                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-shopping-bag"></i>
                                </div>
                                <h5><%= totalOrders %></h5>
                                <p class="text-muted mb-0">Total Orders</p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-heart"></i>
                                </div>
                                <h5>7</h5>
                                <p class="text-muted mb-0">Wishlist Items</p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="dashboard-card p-4 text-center">
                                <div class="dashboard-icon">
                                    <i class="fas fa-star"></i>
                                </div>
                                <h5>5</h5>
                                <p class="text-muted mb-0">Reviews</p>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Orders -->
                    <div class="card mb-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Recent Orders</h5>
                        </div>

                        <% if (orders && orders.length > 0) { %>
                            <div class="card-body">
                                <% orders.slice(0, 5).forEach((order, index) => { %>
                                    <div class="purchase-history-item <%= index < orders.slice(0, 5).length - 1 ? 'border-bottom pb-3 mb-3' : '' %>">
                                        <div class="row align-items-center">
                                            <!-- First Product Image -->
                                            <div class="col-md-2 col-3">
                                                <% if (order.items[0].product && order.items[0].product.images && order.items[0].product.images.length > 0) { %>
                                                    <img src="<%= order.items[0].product.images[0] %>" 
                                                        alt="<%= order.items[0].name %>" 
                                                        class="img-fluid rounded"
                                                        style="max-height: 80px; object-fit: cover;">
                                                <% } else { %>
                                                    <img src="/images/placeholder.jpg" 
                                                        alt="Product" 
                                                        class="img-fluid rounded"
                                                        style="max-height: 80px; object-fit: cover;">
                                                <% } %>
                                            </div>

                                            <!-- Product Name & Order Number -->
                                            <div class="col-md-4 col-9">
                                                <h6 class="mb-1">
                                                    <%= order.items[0].name %>
                                                    <% if (order.items.length > 1) { %>
                                                        <span class="badge bg-light text-dark ms-1">+<%= order.items.length - 1 %> more</span>
                                                    <% } %>
                                                </h6>
                                                <small class="text-muted"><%= order.orderNumber %></small>
                                            </div>

                                            <!-- Order Date (Hidden on mobile) -->
                                            <div class="col-md-2 d-none d-md-block">
                                                <small><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></small>
                                            </div>

                                            <!-- Status Badge -->
                                            <div class="col-md-2 col-6 mt-2 mt-md-0">
                                                <% 
                                                    let badgeClass = 'bg-secondary';
                                                    if (order.orderStatus === 'delivered') badgeClass = 'bg-success';
                                                    else if (order.orderStatus === 'confirmed') badgeClass = 'bg-info';
                                                    else if (order.orderStatus === 'shipped') badgeClass = 'bg-primary';
                                                    else if (order.orderStatus === 'pending') badgeClass = 'bg-warning text-dark';
                                                    else if (order.orderStatus === 'cancelled') badgeClass = 'bg-danger';
                                                %>
                                                <span class="badge <%= badgeClass %> text-capitalize"><%= order.orderStatus %></span>
                                            </div>

                                            <!-- View Button -->
                                            <div class="col-md-2 col-6 text-end mt-2 mt-md-0">
                                                <a href="/dashboard/orders" class="btn btn-sm btn-outline-dark">View</a>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>

                                <!-- View All Orders Link -->
                                <% if (orders.length > 5) { %>
                                    <div class="text-center mt-3 pt-3 border-top">
                                        <a href="/dashboard/orders" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-list me-2"></i>View All Orders (<%= orders.length %>)
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <!-- Empty State -->
                            <div class="card-body">
                                <div class="cart-empty text-center py-5" id="empty-cart">
                                    <i class="far fa-heart" style="font-size: 3rem; color: #ccc;"></i>
                                    <h3 class="mt-3">No Orders Yet</h3>
                                    <p class="text-muted">Start your fragrance journey by placing your first order.</p>
                                    <a href="/products" class="btn btn-cart">Discover Scents</a>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- My Reviews Section -->
                        <div class="reviews-dashboard-section">
                        <div class="dashboard-header mb-5">
                            <h3 class="dashboard-title">
                                <i class="fas fa-star me-3 text-amber"></i>My Reviews
                            </h3>
                            <p class="dashboard-subtitle text-muted">Your fragrance experiences and opinions</p>
                        </div>

                        <% if (myReviews.length === 0) { %>
                        <!-- Empty State -->
                        <div class="empty-reviews-state text-center py-5">
                            <div class="empty-icon mb-4">
                                <i class="fas fa-pen-fancy text-muted" style="font-size: 4rem;"></i>
                            </div>
                            <h4 class="text-muted mb-3">No Reviews Yet</h4>
                            <p class="text-muted mb-4">Share your thoughts on the fragrances you've experienced</p>
                            <a href="/products" class="btn btn-amber">
                                <i class="fas fa-shopping-bag me-2"></i>Write a review
                            </a>
                        </div>
                        <% } else { %>
                        
                        <!-- Reviews Stats -->
                        <div class="reviews-stats mb-4">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="stat-card text-center p-3">
                                        <div class="stat-number display-6 fw-bold text-amber"><%= myReviews.length %></div>
                                        <div class="stat-label text-muted">Total Reviews</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card text-center p-3">
                                        <div class="stat-number display-6 fw-bold text-amber">
                                            <%= (myReviews.reduce((acc, r) => acc + r.rating, 0) / myReviews.length).toFixed(1) %>
                                        </div>
                                        <div class="stat-label text-muted">Average Rating</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card text-center p-3">
                                        <div class="stat-number display-6 fw-bold text-amber">
                                            <%= myReviews.filter(r => r.rating >= 4).length %>
                                        </div>
                                        <div class="stat-label text-muted">Loved Fragrances</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-card text-center p-3">
                                        <div class="stat-number display-6 fw-bold text-amber">
                                            <%= new Set(myReviews.map(r => r.product.category)).size %>
                                        </div>
                                        <div class="stat-label text-muted">Categories Reviewed</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reviews Filter and Sort -->
                        <div class="reviews-controls mb-4">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <div class="filter-buttons">
                                        <button class="btn btn-outline-amber btn-sm active" data-filter="all">All Reviews</button>
                                        <button class="btn btn-outline-amber btn-sm" data-filter="5">5 Stars</button>
                                        <button class="btn btn-outline-amber btn-sm" data-filter="4">4+ Stars</button>
                                        <button class="btn btn-outline-amber btn-sm" data-filter="recent">Recent</button>
                                    </div>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <select class="form-select form-select-sm w-auto d-inline-block" id="sortReviews">
                                        <option value="newest">Newest First</option>
                                        <option value="oldest">Oldest First</option>
                                        <option value="highest">Highest Rated</option>
                                        <option value="lowest">Lowest Rated</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Reviews Grid -->
                        <div class="reviews-grid">
                            <div class="row">
                                <% myReviews.forEach(r => { %>
                                <div class="col-lg-6 mb-4" data-rating="<%= r.rating %>" data-date="<%= r.createdAt.getTime() %>">
                                    <div class="review-card card border-0 shadow-sm h-100">
                                        <div class="card-body">
                                            <!-- Product Header -->
                                            <div class="product-header d-flex align-items-center mb-3">
                                                <div class="product-image me-3">
                                                    <img src="<%= r.product.images[0] %>" 
                                                        alt="<%= r.product.name %>" 
                                                        class="img-fluid rounded" 
                                                        style="width: 60px; height: 60px; object-fit: cover;">
                                                </div>
                                                <div class="product-info flex-grow-1">
                                                    <h6 class="product-name mb-1">
                                                        <a href="/products/<%= r.product._id %>" class="text-decoration-none text-dark">
                                                            <%= r.product.name %>
                                                        </a>
                                                    </h6>
                                                    <span class="product-category badge bg-amber-light text-amber">
                                                        <%= r.product.category %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Rating and Date -->
                                            <div class="review-meta d-flex justify-content-between align-items-center mb-3">
                                                <div class="star-rating">
                                                    <% for(let i=1; i<=5; i++){ %>
                                                        <i class="fas fa-star <%= i <= r.rating ? 'text-amber' : 'text-light' %>"></i>
                                                    <% } %>
                                                    <span class="rating-value ms-2 fw-bold text-amber"><%= r.rating %></span>
                                                </div>
                                                <span class="review-date text-muted">
                                                    <%= r.createdAt.toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'short', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </span>
                                            </div>

                                            <!-- Review Content -->
                                            <% if (r.title) { %>
                                            <h6 class="review-title mb-2 text-dark">"<%= r.title %>"</h6>
                                            <% } %>
                                            
                                            <p class="review-comment mb-3"><%= r.comment %></p>

                                            <!-- Review Actions -->
                                            <div class="review-actions d-flex justify-content-between align-items-center pt-3 border-top">
                                                <div class="action-buttons">
                                                    <button class="btn btn-sm btn-outline-amber me-2 edit-review" 
                                                            data-review-id="<%= r._id %>">
                                                        <i class="fas fa-edit me-1"></i>Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger delete-review" 
                                                            data-review-id="<%= r._id %>">
                                                        <i class="fas fa-trash me-1"></i>Delete
                                                    </button>
                                                </div>
                                                <div class="review-stats text-muted">
                                                    <small>
                                                        <i class="fas fa-thumbs-up me-1"></i>
                                                        <span class="helpful-count">0</span> found helpful
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                        </div>

                        <!-- Load More (if needed) -->
                        <% if (myReviews.length > 6) { %>
                        <div class="text-center mt-4">
                            <button class="btn btn-outline-amber" id="loadMoreReviews">
                                <i class="fas fa-chevron-down me-2"></i>Load More Reviews
                            </button>
                        </div>
                        <% } %>
                        
                        <% } %>
                    </div>


