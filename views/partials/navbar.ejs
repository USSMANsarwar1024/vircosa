    }

    .search-input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 40px rgba(139, 90, 43, 0.3);
        background: white;
    }

    .search-submit-btn {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 55px;
        height: 55px;
        border-radius: 50%;
