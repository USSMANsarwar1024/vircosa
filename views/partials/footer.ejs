<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Set current page URL for newsletter redirect
    document.addEventListener('DOMContentLoaded', function () {
        const redirectInput = document.getElementById('currentPageUrl');
        if (redirectInput) {
            redirectInput.value = window.location.pathname + window.location.search;
        }

        // Intersection Observer for fade-in animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in-up').forEach(el => {
            observer.observe(el);
        });
    });

    // Handle newsletter form submission feedback
    const params = new URLSearchParams(window.location.search);

    if (params.get("newsletter") === "success") {
        Swal.fire({
            icon: "success",
            title: "Welcome to the Vircosa Family!",
            text: "Thank you for joining us. Check your email for your exclusive 10% discount code!",
            confirmButtonColor: "#8B5A2B",
            confirmButtonText: "Amazing!"
        });

        params.delete("newsletter");
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, "", cleanUrl);
    }

    if (params.get("newsletter") === "exists") {
        Swal.fire({
            icon: "info",
            title: "You're Already Part of Our Journey!",
            text: "We're grateful to have you with us. Stay tuned for exclusive updates.",
            confirmButtonColor: "#8B5A2B",
            confirmButtonText: "Wonderful!"
        });

        params.delete("newsletter");
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, "", cleanUrl);
    }

    if (params.get("newsletter") === "error") {
        Swal.fire({
            icon: "error",
            title: "Oops, Something Went Wrong",
            text: "Please try again or contact us if the issue persists.",
            confirmButtonColor: "#8B5A2B",
            confirmButtonText: "Try Again"
        });

        params.delete("newsletter");
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, "", cleanUrl);
    }
</script>