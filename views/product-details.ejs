    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script>
        // Initialize carousel FIRST - this is critical
        document.addEventListener('DOMContentLoaded', function() {
            
            // CAROUSEL INITIALIZATION
            const carouselElement = document.getElementById('productCarousel');
            
            if (carouselElement) {                
                // Initialize Bootstrap Carousel
                const carousel = new bootstrap.Carousel(carouselElement, {
                    interval: 9000, // 9 seconds auto-play
                    wrap: true, // Loop back to start
                    touch: true, // Enable touch swiping
                    keyboard: true // Enable keyboard navigation
                });
                
                
                // Set up thumbnail navigation
                const thumbnails = document.querySelectorAll('.product-thumbnail');
                if (thumbnails.length > 0) {
                    thumbnails.forEach((thumb, index) => {
                        thumb.addEventListener('click', function(e) {
                            e.preventDefault();
                            // Update thumbnails
                            thumbnails.forEach(t => t.classList.remove('active'));
                            this.classList.add('active');
                            // Go to slide
                            carousel.to(index);
                        });
                    });
                    
                    // Update thumbnails on slide change
                    carouselElement.addEventListener('slid.bs.carousel', function(event) {
                        const activeIndex = event.to;
                        thumbnails.forEach((thumb, index) => {
                            if (index === activeIndex) {
                                thumb.classList.add('active');
                            } else {
                                thumb.classList.remove('active');
                            }
                        });
                    });
                }
                
                // Manual control button listeners (just in case)
                const nextBtn = carouselElement.querySelector('.carousel-control-next');
                const prevBtn = carouselElement.querySelector('.carousel-control-prev');
                
                if (nextBtn) {
                    nextBtn.addEventListener('click', function() {
                        carousel.next();
                    });
                }
                
                if (prevBtn) {
                    prevBtn.addEventListener('click', function() {
                        carousel.prev();
                    });
                }
                
                // Debug function
                window.debugCarousel = function() {
                    console.log('=== CAROUSEL DEBUG ===');
                    console.log('Current active slide:', 
                        carouselElement.querySelector('.carousel-item.active').getAttribute('data-index'));
                    console.log('Total slides:', carouselElement.querySelectorAll('.carousel-item').length);
                    console.log('Bootstrap instance:', carousel ? 'Found' : 'Not found');
                    console.log('=== END DEBUG ===');
                };
                
            } else {
                console.error('ERROR: Carousel element with ID "productCarousel" not found!');
                console.error('Check the HTML for the carousel element');
            }
            
            // Rest of your product functionality... (keep your existing code below)
            // Product functionality
            const variants = <%- JSON.stringify(product.variants) %>;
            let selectedVariant = variants[0];
            let qty = 1;

            // Size selector
            document.querySelectorAll('.size-option').forEach((option, index) => {
                option.addEventListener('click', function() {
                    document.querySelectorAll('.size-option').forEach(o => o.classList.remove('active'));
                    this.classList.add('active');
                    selectedVariant = variants[index];
                    updatePrice();
                    updateStockBadge();
                });
            });

            function changeQty(change) {
                qty = Math.max(1, Math.min(qty + change, selectedVariant.stock));
                document.getElementById('quantity').value = qty;
                updatePrice();
            }

            function updatePrice() {
                document.getElementById('price').textContent = (selectedVariant.price * qty).toLocaleString();
            }

            function updateStockBadge() {
                const badge = document.getElementById('stock-badge');
                const stock = selectedVariant.stock;
                badge.className = 'stock-badge';
                
                if (stock > 10) {
                    badge.classList.add('in-stock');
                    badge.textContent = 'In Stock';
                } else if (stock > 0) {
                    badge.classList.add('low-stock');
                    badge.textContent = `Only ${stock} left`;
                } else {
                    badge.classList.add('out-of-stock');
                    badge.textContent = 'Out of Stock';
                }
            }

            // ✅ REVIEW FORM SUBMISSION
            const reviewForm = document.getElementById('reviewForm');
            if (reviewForm) {
                // Rating stars interaction
                const ratingStars = document.querySelectorAll('.rating-input-large .fa-star');
                const ratingInput = document.getElementById('reviewRating');
                
                ratingStars.forEach(star => {
                    star.addEventListener('click', function() {
                        const rating = this.getAttribute('data-rating');
                        ratingInput.value = rating;
                        
                        ratingStars.forEach(s => {
                            if (s.getAttribute('data-rating') <= rating) {
                                s.classList.remove('far');
                                s.classList.add('fas', 'active');
                            } else {
                                s.classList.remove('fas', 'active');
                                s.classList.add('far');
                            }
                        });
                    });
                });

                // Form submission
                reviewForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const rating = ratingInput.value;
                    const orderId = document.getElementById('orderSelect').value;
                    
                    if (!rating) {
                        showNotification('Please select a rating', 'warning');
                        return;
                    }
                    
                    if (!orderId) {
                        showNotification('Please select your order', 'warning');
                        return;
                    }
                    
                    const formData = {
                        rating: rating,
                        title: document.getElementById('reviewTitle').value,
                        comment: document.getElementById('reviewComment').value,
                        orderId: orderId
                    };
                    
                    try {
                        const response = await fetch('/products/product-details/<%= product._id %>/review', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(formData)
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            showNotification('✅ ' + data.message, 'success');
                            setTimeout(() => location.reload(), 800);
                        } else {
                            showNotification('❌ ' + data.message, 'error');
                        }
                    } catch (err) {
                        console.error('Review error:', err);
                        showNotification('Failed to submit review', 'error');
                    }
                });
            }

            // Sort reviews
            const sortSelect = document.getElementById('sortReviews');
            if (sortSelect) {
                sortSelect.addEventListener('change', function() {
                    const reviewItems = Array.from(document.querySelectorAll('.review-item'));
                    const reviewsList = document.querySelector('.reviews-list');
                    
                    reviewItems.sort((a, b) => {
                        const ratingA = parseInt(a.getAttribute('data-rating'));
                        const ratingB = parseInt(b.getAttribute('data-rating'));
                        const dateA = parseInt(a.getAttribute('data-date'));
                        const dateB = parseInt(b.getAttribute('data-date'));
                        
                        switch(this.value) {
                            case 'newest': return dateB - dateA;
                            case 'highest': return ratingB - ratingA;
                            case 'lowest': return ratingA - ratingB;
                            default: return 0;
                        }
                    });
                    
                    reviewItems.forEach(item => reviewsList.appendChild(item));
                });
            }

            // Add to cart functionality
            document.getElementById('addToCartBtn')?.addEventListener('click', async function() {
                const activeVariant = document.querySelector('.size-option.active');

                try {
                    const includeBoxCheckbox = document.getElementById('includeBox');
                    const includeBox = includeBoxCheckbox ? includeBoxCheckbox.checked : false;
                    const boxPrice = includeBox ? parseInt(includeBoxCheckbox.dataset.boxPrice) : 0;

                    const res = await fetch('/cart/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            productId: '<%= product._id %>',
                            size: parseInt(activeVariant.dataset.size),
                            price: parseInt(activeVariant.dataset.price),
                            quantity: qty,
                            includeBox: includeBox,
                            boxPrice: boxPrice
                        })
                    });

                    const contentType = res.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        if (res.status === 401 || res.redirected) {
                            showNotification('❌ Please log in to add items to cart', 'error');
                            return;
                        }
                        throw new Error('Invalid response from server');
                    }

                    const data = await res.json();

                    if (res.status === 401) {
                        showNotification('❌ Please log in to add items to cart', 'error');
                        return;
                    }

                    if (res.ok) {
                        showNotification('🛒 Added to Cart!', 'success');
                    } else {
                        showNotification('❌ ' + (data.message || 'Error adding to cart'), 'error');
                    }
                } catch (error) {
                    console.error('Cart error:', error);
                    const isLoggedIn = '<%= typeof user !== "undefined" && user ? "true" : "false" %>';
                    if (isLoggedIn === 'false') {
                        showNotification('❌ Please log in to add items to cart', 'error');
                        setTimeout(() => window.location.href = '/login', 1500);
                    } else {
                        showNotification('❌ Network error occurred. Please try again.', 'error');
                    }
                }
            });

            // Add to wishlist functionality
            document.querySelectorAll('.add-to-wishlist-btn').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const productId = btn.dataset.productId;

                    try {
                        const res = await fetch('/wishlist/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId })
                        });

                        const contentType = res.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            if (res.status === 401 || res.redirected) {
                                showNotification('❌ Please log in to add items to wishlist', 'error');
                                return;
                            }
                            throw new Error('Invalid response from server');
                        }

                        const data = await res.json();

                        if (res.status === 401) {
                            showNotification('❌ Please log in to add items to wishlist', 'error');
                            setTimeout(() => window.location.href = '/login', 1500);
                            return;
                        }

                        if (res.ok) {
                            showNotification('💖 Added to Wishlist!', 'success');
                            btn.querySelector('i').classList.remove('far');
                            btn.querySelector('i').classList.add('fas');
                        } else {
                            showNotification('❌ ' + (data.message || 'Error adding to wishlist'), 'error');
                        }
                    } catch (error) {
                        console.error('Wishlist error:', error);
                        const isLoggedIn = '<%= typeof user !== "undefined" && user ? "true" : "false" %>';
                        if (isLoggedIn === 'false') {
                            showNotification('❌ Please log in to add items to wishlist', 'error');
                        } else {
                            showNotification('❌ Network error occurred. Please try again.', 'error');
                        }
                    }
                });
            });

            // Notification system
            function showNotification(message, type = 'info') {
                const existingNotifications = document.querySelectorAll('.notification');
                existingNotifications.forEach(notif => notif.remove());

                const notification = document.createElement('div');
                notification.className = `notification ${type}`;
                notification.innerHTML = `
                    ${message}
                    <button class="notification-close">&times;</button>
                `;
                
                document.body.appendChild(notification);
                
                setTimeout(() => notification.classList.add('show'), 100);
                
                notification.querySelector('.notification-close').addEventListener('click', () => {
                    notification.classList.remove('show');
                    setTimeout(() => notification.remove(), 300);
                });
                
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.classList.remove('show');
                        setTimeout(() => notification.remove(), 300);
                    }
                }, 5000);
            }

            // Check for flash messages
            const successMessage = '<%= typeof success !== "undefined" && success.length > 0 ? success[0] : "" %>';
            const errorMessage = '<%= typeof error !== "undefined" && error.length > 0 ? error[0] : "" %>';
            
            if (successMessage) {
                showNotification(successMessage, 'success');
            }
            if (errorMessage) {
                showNotification(errorMessage, 'error');
            }
        });
    </script>
    
    
    <script type="application/ld+json">
        {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "<%= product.name %>",
        "image": [
            "https://vircosa.com<%= product.images[0] %>"
        ],
        "description": "<%= product.description %>",
        "sku": "<%= product.sku %>",
        "brand": {
            "@type": "Brand",
            "name": "Vircosa"
        },
        "offers": {
            "@type": "Offer",
            "url": "https://vircosa.com/products/product-details/<%= product.slug %>",
            "priceCurrency": "PKR",
            "price": "<%= product.variants[0].price %>",
            "availability": "https://schema.org/InStock"
        }
        }
    </script>

</body>
</html>